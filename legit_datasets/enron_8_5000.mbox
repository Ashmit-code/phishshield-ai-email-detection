> > >
> > >                3.  (a) 4  (b) 2 (c) 5 (d) 7 (e) 6
> > >
> > >                4.  (a) 4   (b) 6 (c) 2 (d) 1
> > >
> > >                5.  (a) 6 (b) 4 (c) 3 (d) 5  (e) 2
> > >
> > >                6.  (a) 6 (b) 4 (c) 2
> > >
> > >                7.  (a) 6 (b) 2 (c) 4
> > >
